# Emergency break-glass key and preparation-script authentication; use individual account login day to day.
ZARMA_ADMIN_TOKEN=replace-with-a-long-random-secret
# Absolute path recommended for persistent deployments.
ZARMA_DATA_DIR=./data
# Target format created when exporting approved recordings.
ZARMA_EXPORT_SAMPLE_RATE=22050
# Create the first named admin account at startup. Use unique credentials and never commit real secrets.
ZARMA_BOOTSTRAP_ADMIN_USERNAME=admin-local
ZARMA_BOOTSTRAP_ADMIN_PASSWORD=replace-this-with-a-unique-secret-of-14-characters-minimum
# Admin sessions expire in this many hours (1–48; default 12).
ZARMA_SESSION_HOURS=12
